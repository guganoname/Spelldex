{
  "name": "@spelldex/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spelldex Designsystem: Tokens, skeuomorphe Komponenten, Federn, synthetisierte UI-Klänge und Haptik",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/tokens.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./feedback": "./src/feedback/index.ts",
    "./motion": "./src/motion/spring.ts",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "demo": "node scripts/build-demo.mjs",
    "sounds": "node scripts/sound-report.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ios-haptics": "3.2.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "typescript": "5.9.3"
  }
}
